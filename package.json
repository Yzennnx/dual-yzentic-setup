{
  "name": "dual-yzentic-setup",
  "version": "1.0.0",
  "description": "Dual-agent development setup for one developer: Claude Code builds, Antigravity tests",
  "type": "module",
  "scripts": {
    "verify:agent": "node scripts/baton.mjs verify",
    "sync:status": "node scripts/baton.mjs status",
    "sync:reset": "node scripts/baton.mjs reset",
    "skill:list": "node scripts/skills-manager.mjs list",
    "skill:enable": "node scripts/skills-manager.mjs enable",
    "skill:disable": "node scripts/skills-manager.mjs disable",
    "init:project": "node scripts/init-project.mjs",
    "tailor": "node scripts/tailor.mjs",
    "scout": "node scripts/scout.mjs",
    "agy:build": "node scripts/agy-build.mjs",
    "agy:qa": "node scripts/agy-build.mjs --qa",
    "e2e:qa": "playwright test --project=qa",
    "mockups:check": "node scripts/mockups-check.mjs",
    "rules:check": "node scripts/rules-check.mjs",
    "rules:map": "node scripts/rules-map.mjs",
    "review": "node scripts/review.mjs",
    "hook:install": "node scripts/install-hooks.mjs",
    "merge": "node scripts/baton.mjs merge"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "antigravity",
    "dual-agent"
  ],
  "author": "",
  "license": "MIT"
}
